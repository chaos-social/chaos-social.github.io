+     * Android probes vertical editor navigation while opening the IME. Keep that
+     * search in the input wrapper: RN 0.86's outer ScrollView fallback traverses
+     * transient Fabric children and can crash in findShadowNodeByTag_DEPRECATED.
+     */
+    if (direction == View.FOCUS_UP || direction == View.FOCUS_DOWN) {
+      return FocusFinder.getInstance().findNextFocus(this, focused, direction)
+    }
+    return super.focusSearch(focused, direction)
